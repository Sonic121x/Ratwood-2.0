GLOBAL_LIST_INIT(familiar_lore_blurbs, list(
	/mob/living/simple_animal/pet/familiar/pondstone_toad = "池塘石蟾蜍古老而耐心，据说承载着沼泽的智慧。它们沉着坚韧，常常默默观察周遭的一切。",
	/mob/living/simple_animal/pet/familiar/mist_lynx = "雾影猞猁神秘而难觅踪影，能在雾气与阴影中悄然穿行。它们聪慧敏锐，对自己信赖的人忠诚至极。",
	/mob/living/simple_animal/pet/familiar/rune_rat = "符文鼠机敏好奇，总在追寻知识。秘密与文字吸引着它们，所到之处都会留下发光的符文。",
	/mob/living/simple_animal/pet/familiar/vaporroot_wisp = "蒸气根精魄是与雾气和治愈相伴的温柔精灵。它们静静飘荡，为身边的人带来安宁与慰藉。",
	/mob/living/simple_animal/pet/familiar/ashcoiler = "灰烬盘绕者是诞生于被遗忘的炉火与潜藏魔力中的蛇。它们耐心而持久，能带来坚韧的力量。",
	/mob/living/simple_animal/pet/familiar/glimmer_hare = "微光兔迅捷而难以捕捉，身体闪烁着微光。它们象征幸运与敏捷，总能先危险一步逃离。",
	/mob/living/simple_animal/pet/familiar/hollow_antlerling = "空心角鹿是温柔的森林精灵，象征幸运与新生。它们顽皮好奇，为同伴带来好运。",
	/mob/living/simple_animal/pet/familiar/gravemoss_serpent = "墓苔巨蛇是古老的大地守护者，鳞片上点缀着地衣与墓尘。它们睿智而耐心，与生死轮回紧密相连。",
	/mob/living/simple_animal/pet/familiar/starfield_crow = "星域扎德神秘而聪慧，羽毛上闪烁着星座。它们是命运的预兆，也是秘密的守护者。",
	/mob/living/simple_animal/pet/familiar/emberdrake = "余烬幼龙是承载温暖与记忆的小龙。它们的出现能唤起旧日故事，在最黑暗的夜里带来慰藉。",
	/mob/living/simple_animal/pet/familiar/ripplefox = "涟漪狐既是诡计多端的精灵，也是引路者，身影在视野边缘闪烁。它们精通幻术，知道的似乎总比表现出来的更多。",
	/mob/living/simple_animal/pet/familiar/whisper_stoat = "低语鼬细腻敏锐，聆听思绪与秘密。它们是值得信赖的知己，也是聪慧的伙伴。",
	/mob/living/simple_animal/pet/familiar/thornback_turtle = "棘背龟是坚实的守护者，体现着耐力与庇护。它们不易动怒，却会坚定地保护朋友。",
))
