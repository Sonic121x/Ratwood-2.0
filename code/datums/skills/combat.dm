/datum/skill/combat
	abstract_type = /datum/skill/combat
	name = "战斗"
	desc = ""
	dream_cost_base = 2
	dream_cost_per_level = 1
	color = "#ec994b"
	max_skillbook_level = 3
	max_untraited_level = SKILL_LEVEL_EXPERT
	trait_uncap = list(TRAIT_MARTIAL_PROWESS = SKILL_LEVEL_LEGENDARY) //if the veteran trains you and then you find a vampire knight with legendary i guess

/datum/skill/combat/knives
	name = "匕首战斗"
	desc = "使用匕首时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。达到学徒或更高等级后，我从弹带中抽出匕首时不会失手。"
	dreams = list(
		"...酒保一边擦着杯子一边吹口哨，醉汉趴在柜台上打着鼾。整间酒馆都屏住呼吸望着你，你的匕首在指间来回穿梭，展露出令人惊叹的巧手把戏……",
		"...寒光划过天际，一道，又一道，再一道。刀刃在你抛接的双手间来回穿梭，仿佛你正牵引着一根粗实的绳索……",
		"...你把刀刃藏回斗篷中，坦然任人搜查。那把隐而不见的小刀，终究无法被招架……"
	)
	expert_name = "捅刺者"


/datum/skill/combat/swords
	name = "剑术"
	desc = "使用剑类时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
		"...你的重刃划出宽阔弧线，咆哮着撕开空气。每一次命中的斩击都带着碎骨之力。对手的盾牌在那重量下凹陷，而你的剑终于命中目标，将护甲、血肉与意志一并碾碎……",
		"...那是一截闪耀着光泽的象牙色钢刃。它是信物，是象征，不只是一件武器。洗槽中血水翻涌，磨石上火星四溅。你保养着刀剑，而它也守护着你的荣誉……",
		"...细剑在你手中舞动，宛如一缕低语般的钢光划开空气。每一次刺击都精准无比，每一次招架与回击都流畅得恰到好处，只待那一瞬以致命一击封死对方的命运……"
	)
	expert_name = "剑士"

/datum/skill/combat/polearms
	name = "长柄武器"
	desc = "使用长柄武器时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
	"...那头苍白的沃尔夫张口撕咬，却徒劳无功。你的武器拥有更长的距离优势，你精准地一刺又一刺，直到它鲜血淋漓地退回林中……",
	"...手持那根可靠的长杖，你轻松踏过污泥与沼泽。它不只是兵器，也是工具；坚实的长度在你前行时给予支撑，让你无惧那厚重而无休无止的泥泞……",
	"...钩镰在空中低鸣，弯钩刀刃以冰冷的精准掠过。锁甲与皮革都被它撕裂。随着每一次扭转，你的攻击愈发无可避免、毫无滞涩，宛如一场无情而流畅的毁灭之舞……"
	)
	expert_name = "长兵使"

/datum/skill/combat/maces
	name = "钝器"
	desc = "使用钝器时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
	"……黑暗包围着你。你一遍遍砸向墙壁，每次重击的闷响都在颅内回荡。墙壁颤抖着，最后一记撼地重击过后，光线透入，你终于重获自由……",
	"……“我不可言喻，亦不可刺穿。”邪恶的白色守卫如是说道。于是你用钉锤一击粉碎了它的头颅——毕竟，它可没说自己砸不碎……",
	"……空气随你的每一次重击颤动，每声回响都像丧钟最后的鸣响。这就是你的交响曲。尽情沉醉于它残酷的美与摧枯拉朽的简洁吧……",
	"……“这把剑是玛勒姆工艺的杰作。”精灵宣告道。片刻之后，他的脑袋就在你粗野兵器的重压下，骤然化作铺路的装饰……"
	)
	expert_name = "钉锤手"

/datum/skill/combat/axes
	name = "斧术"
	desc = "使用斧类时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
	"……骨头就像树木，越大，倒下时摔得越重。你凶猛挥击，斩落骷髅的头颅，从它的邪恶中拯救了城镇……",
	"……武器卡在血肉里，你使劲一拔，终于将它扯出。鲜血溅上你的盔甲、披风与半边脸。狩猎并不轻松，但老人的教诲确实有效……",
	"……斧刃落下，又一棵树倒了。湿润的汁液流过你的脸，你不知疲倦地劈砍，把森林砍成灌木丛，又把灌木丛砍成空旷平原。直到停下来低头望去，你才看见碎骨、撕裂的血肉与扭曲的面孔。城镇广场已化为猩红，浸透了你狂怒留下的余波……",
	"……铁的重量牵引着你的手臂。它知道自己该落在何处——你只需引导它落下。明白这一点后，斧头似乎比记忆中轻了许多……",
	"……纵使挑战无法逾越，你也无所畏惧，因为斧头是你永恒的伙伴。解决问题，其实就是这么简单……"
	)
	expert_name = "斧手"

/datum/skill/combat/whipsflails
	name = "鞭与链枷"
	desc = "使用鞭子或链枷时，我成功招架与绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
	"……链枷的鸣唱划破空气，唤醒某种原始本能；然而你的手向下一挥，又迅速让它沉睡……",
	"……呼啸、抽击、脆响，皮肉上又多了一道淤伤。你猛然一扯，再次挥下。他们终会被驯服……"
	)
	expert_name = "鞭手"

/datum/skill/combat/bows
	name = "弓术"
	desc = "配合感知属性时，我能更快地张弓搭箭并做好射击准备。不会影响伤害或命中几率。"
	dreams = list(
	"……阳台上的冷风从左侧吹来，你便迎风调整准星。手指松开，弓发出轻轻一叹。片刻之后，目标倒在下方的鹅卵石街道上。死了……",
	"……你又放出一箭，手指阵阵刺痛，箭矢却擦过苍白骑士的胸甲。你瞄准其面甲，向自己信奉的神明祈祷，希望这一箭能够穿透……",
	"……熟练的弩手上弦装填也需要半分钟。而你只需一半时间，就能用三支箭杀死五个人……"
	)
	expert_name = "弓手"
	max_untraited_level = SKILL_LEVEL_LEGENDARY

/datum/skill/combat/crossbows
	name = "弩术"
	desc = "配合感知属性时，我能更快地架好十字弩并做好射击准备。不会影响伤害或命中几率。"
	dreams = list(
	"……你踩住弩身，拼尽全力拉弦。它像在嘲笑你，怎么也拉不紧。直到一位老练弩手提醒你，用背部而非膝盖发力，你才终于有了进展……",
	"……弩是工程技艺造就的致命奇迹，只等你的引导。你稳住呼吸，手指搭在扳机上。随着准星收拢，世界也变得狭窄，完美的一击即将到来……"
	)
	expert_name = "弩手"
	max_untraited_level = SKILL_LEVEL_LEGENDARY

/datum/skill/combat/wrestling
	name = "摔跤"
	desc = "配合力量属性时，我擒抱对手以及挣脱对方擒抱的几率都会提高。"
	dreams = list(
	"……你抓住他的衣襟，扭手猛推，将对手掀倒在地。尘土灌进肺里，但你感到他的抵抗渐渐松懈；他咳嗽着，脸上露出赞许的笑容……",
	"……尘土呛入肺中，双腿不停颤抖，你站不起来。你听见板甲碰撞的声音，看见沉重的战靴停在面前。你猛扯对方的腿，这个本要杀你的人便翻倒在地……"
	)
	expert_name = "摔角手"

/datum/skill/combat/unarmed
	name = "徒手"
	desc = "徒手或使用拳刃等徒手武器时，我绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。徒手攻击具有迅捷平衡特性：当你比对手更快时，它们更难被招架和闪避。佩戴指虎或护腕即可进行徒手招架。"
	dreams = list(
	"……皮肉撞击骨头的湿闷声与牙齿碰撞的脆响先钻进耳中，你才意识到发生了什么。下巴挨了一记重拳，你就此失去知觉……",
	"……你的指甲就是利爪，双手就是武器。一名身着苍白板甲的沉默旁观者，为你的凶猛赞许地点头……"
	)
	expert_name = "拳师"

/datum/skill/combat/shields
	name = "盾术"
	desc = "使用盾牌时，我绕过对手招架的几率提高 20%，绕过闪避的几率提高 10%。"
	dreams = list(
	"……恐怖的巨蜥向你喷出烈火洪流。你却岿然不动，宛如活着的堡垒，坚定不屈……",
	"……即使在阿斯特拉塔明亮的白昼里，盾上的半月纹章依然闪耀。你瞥见一道亮光，本能地抬起盾牌。一支箭被弹开……"
	)
	expert_name = "持盾者"

/datum/skill/combat/slings
	name = "投石索"
	desc = "配合感知属性时，我能更快地甩动投石索并做好发射准备。不会影响伤害或命中几率。"
	dreams = list(
	"……你想起档案馆蒙尘古书中的一句格言：只要会投掷，就会用投石索……",
	"……高处的弓手无情地击退农民起义。公平的希望几乎破灭，直到一声轻响过后，铁弹如雨般砸向敌人的头盔……",
	"……反复练习让手臂疲惫，快速挥转更令它麻木。你倦怠地望向一旁，看见猎人以短促的过肩动作练习投掷。你领会并模仿这一技巧，轻松掷出一枚劲石，正中靶心……"
	)
	expert_name = "投石手"
	max_untraited_level = SKILL_LEVEL_LEGENDARY

/datum/skill/combat/firearms
	name = "火器"
	desc = "配合感知属性时，我能更快地整备火器并使其进入待发状态。不会影响伤害或命中几率。 \
	此外，它还能降低武器哑火或失效的几率。"
	dreams = list(
	"……他让你站直，把枪托抵住肩膀。诸神在上，后坐力可真疼。但靶子呢？哦，靶子已经没了……",
	"……满面风霜的佣兵解释，装药量并非精确的学问。摸清门道后，靠眼看耳听就行。他残缺的手臂却似乎并不赞同……"
	)
	expert_name = "枪手"
	randomable_dream_xp = FALSE
	max_untraited_level = SKILL_LEVEL_JOURNEYMAN//Minimum to use these properly.
	trait_uncap = list(TRAIT_FUSILIER = SKILL_LEVEL_LEGENDARY)

/datum/skill/combat/arcyne
	name = "奥术武装"
	desc = "使用召唤或奥术绑定的武器时，成功招架及突破对手招架的概率提高 20%，突破闪避的概率提高 10%。"
	learnable_in_sleep = FALSE
	max_skillbook_level = 0
	dreams = list(
	"……你将魔力通路塑成刀剑，血液中流淌着钢铁的触感。你已创造过千般兵刃，熟知每一件的分量与锋芒。虽未练习过它们的招式，它们却在你手中行云流水……",
	"……没有兵器会令你的双手感到陌生：弯刃劈砍，长矛突刺，巨剑划出八字。院中的侍从从一招过渡到下一招，而你，从一种兵器转向另一种……7",
	)
	expert_name = "奥术兵器大师"

/datum/skill/combat/staves
	name = "杖术"
	desc = "使用杖类武器时，成功招架及突破对手招架的概率提高 20%，突破闪避的概率提高 10%。"
	dreams = list(
	"……练习时，溪水中的倒影泛起涟漪。每个动作都属于古老而近乎遗忘的套路。每次打击、招架、佯攻，都使水面如绸缎般裂开。普赛顿静静聆听……",
	"……你行走在被遗忘的路上，手杖轻叩石面。强盗狞笑着现身，你却脚步未停。长杖旋转，古老的本能一闪，一人倒地。其余人迟疑了：他们看见的已不是疲惫的老旅人，而是一堂久未领教的课……",
	"……垂死的僧侣把染血的长棍塞入你手中。『世界不是石头，』他嘶哑地说，『而是水。』你挥出一击，棍身仿佛流动起来，寻到了你从未察觉的轨迹……",
	"……摇曳的火光中，你与一个沉默的身影交手。对方的长棍如蛇般盘旋、出击、隐去，随即一切陷入黑暗。醒来后，你仍试图回忆那最后一击的轨迹……",
	"……偷牛贼闯进农庄。你没有剑，只有一根结实的树枝。他们接连倒下，棍棒击穿血肉与骨骼。你终于明白，暴力是一种人人都懂的语言……"
	)
	expert_name = "Quarterstaffer"
