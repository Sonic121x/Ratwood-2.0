/datum/z121_cookbook_catalog/proc/load_section_1()
	add_entry("公爵烤禽", "肉类料理", "奢华", "公爵烤禽  把 1 份香料烤禽放在桌上，依次加入：   大蒜瓣：1 份。   每步基础耗时 3 秒，烹饪技能会影响实际耗时。  完成最后一步即可获得 1 份成品，无需再次加热。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>把 1 份香料烤禽放在桌上，依次加入：</p><ol><li>大蒜瓣：1 份。</li></ol><p>每步基础耗时 3 秒，烹饪技能会影响实际耗时。</p><p>完成最后一步即可获得 1 份成品，无需再次加热。</p></div>")
	add_entry("公爵牛排", "肉类料理", "奢华", "公爵牛排  把 1 份胡椒牛排放在桌上，依次加入：   大蒜瓣：1 份。   每步基础耗时 3 秒，烹饪技能会影响实际耗时。  完成最后一步即可获得 1 份成品，无需再次加热。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>把 1 份胡椒牛排放在桌上，依次加入：</p><ol><li>大蒜瓣：1 份。</li></ol><p>每步基础耗时 3 秒，烹饪技能会影响实际耗时。</p><p>完成最后一步即可获得 1 份成品，无需再次加热。</p></div>")
	add_entry("嫩炸鸟排", "肉类料理", "奢华", "嫩炸鸟排  取 1 份未完成的嫩炸鸟肉，先加入 1 枚蛋，再加入 1 份面包屑，最后油炸。  将锅架在点燃的炉膛上，装入至少 5 单位炼制油脂，锅内不能有水。用材料点击炉膛油炸，获得 1 份成品；每份消耗 5 单位油脂，基础油炸时间为 5 秒，受烹饪技能影响。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>取 1 份未完成的嫩炸鸟肉，先加入 1 枚蛋，再加入 1 份面包屑，最后油炸。</p><p>将锅架在点燃的炉膛上，装入至少 5 单位炼制油脂，锅内不能有水。用材料点击炉膛油炸，获得 1 份成品；每份消耗 5 单位油脂，基础油炸时间为 5 秒，受烹饪技能影响。</p></div>")
	add_entry("嫩鹿里脊", "肉类料理", "奢华", "嫩鹿里脊  材料：1 份鹿腰肉。  放进已点燃的烤炉烘烤，获得 1 份成品；基础加热时间约 30 秒，受烹饪技能影响。完成后及时取出。   材料：1 份鹿腰肉。  将煎锅架在点燃的炉膛上，再放入材料煎熟，获得 1 份成品；基础加热时间约 30 秒，受烹饪技能影响。完成后及时取出。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>材料：1 份鹿腰肉。</p><p>放进已点燃的烤炉烘烤，获得 1 份成品；基础加热时间约 30 秒，受烹饪技能影响。完成后及时取出。</p></div><div class=\"method\"><h3>制作方法 2</h3><p>材料：1 份鹿腰肉。</p><p>将煎锅架在点燃的炉膛上，再放入材料煎熟，获得 1 份成品；基础加热时间约 30 秒，受烹饪技能影响。完成后及时取出。</p></div>")
	add_entry("森林恩赐", "肉类料理", "奢华", "森林恩赐  把 1 份鹿腰肉放在桌上，依次加入：   红葡萄酒：5 单位。  杰克莓：1 份。   每步基础耗时 2 秒，烹饪技能会影响实际耗时。  组装后放入点燃的烤炉烘烤，或放入炉膛上的煎锅煎熟，获得 1 份成品。及时取出，避免烧焦。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>把 1 份鹿腰肉放在桌上，依次加入：</p><ol><li>红葡萄酒：5 单位。</li><li>杰克莓：1 份。</li></ol><p>每步基础耗时 2 秒，烹饪技能会影响实际耗时。</p><p>组装后放入点燃的烤炉烘烤，或放入炉膛上的煎锅煎熟，获得 1 份成品。及时取出，避免烧焦。</p></div>")
	add_entry("森林珍藏", "肉类料理", "奢华", "森林珍藏  把 1 份鹿肉上等切块放在桌上，依次加入：   洋葱片：1 份。  蒜瓣：1 份。   每步基础耗时 1 秒，烹饪技能会影响实际耗时。  组装后放入点燃的烤炉烘烤，或放入炉膛上的煎锅煎熟，获得 1 份成品。及时取出，避免烧焦。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>把 1 份鹿肉上等切块放在桌上，依次加入：</p><ol><li>洋葱片：1 份。</li><li>蒜瓣：1 份。</li></ol><p>每步基础耗时 1 秒，烹饪技能会影响实际耗时。</p><p>组装后放入点燃的烤炉烘烤，或放入炉膛上的煎锅煎熟，获得 1 份成品。及时取出，避免烧焦。</p></div>")
	add_entry("炸肉排", "肉类料理", "奢华", "炸肉排  取 1 份未完成的炸肉排，先加入 1 枚蛋，再加入 1 份面包屑，最后油炸。  将锅架在点燃的炉膛上，装入至少 5 单位炼制油脂，锅内不能有水。用材料点击炉膛油炸，获得 1 份成品；每份消耗 5 单位油脂，基础油炸时间为 5 秒，受烹饪技能影响。 ", "<div class=\"method\"><h3>制作方法 1</h3><p>取 1 份未完成的炸肉排，先加入 1 枚蛋，再加入 1 份面包屑，最后油炸。</p><p>将锅架在点燃的炉膛上，装入至少 5 单位炼制油脂，锅内不能有水。用材料点击炉膛油炸，获得 1 份成品；每份消耗 5 单位油脂，基础油炸时间为 5 秒，受烹饪技能影响。</p></div>")
