// 日期统一使用年-月-日，界面自动按日期倒序排列；后续更新在此追加日期与中文条目。
// 分类和正文均为纯文本，由展示代码转义，无需填写网页标签。
/proc/z121_changelog_entries()
	var/static/list/entries = list(
		"2026-09-23" = list(
			"炼金药水" = "新增停滞药水：药效期间暂缓生命值过低导致的死亡，但不会治疗伤势，伤害、流血和昏迷仍会发生，药效结束后按当前伤势重新判定状态。气化之躯不再通过普通炼金、RPG商店或贤者之石造物获得。自定义成品药瓶统一沿用普通玻璃瓶的名称、说明及外观。",
			"储物术" = "储物术改为保存当前手中的一件物品，再次施法即可取出，最多保存一件且不限制体积。背包等物品容器不能存入，药瓶、水袋等液体容器可以存入；取出时若双手已满或无法接取，物品会落在脚下。",
			"恐怖之钟" = "每座恐怖之钟的普通召唤与格拉加尔试炼共享每日一次使用机会，随游戏中的黎明刷新。普通召唤仍在敲钟十秒后降临。",
			"死亡回归" = "原美德“永无止境”重做为“死亡回归”：角色入场就绪后建立初始记录，之后在游戏清晨更新记录。死亡时可回到记录的位置及状态，每个游戏日最多触发一次，不再清除记忆。",
			"蛇腹者" = "新增“消化开关”，可以暂停或继续消化，空腹时也能预先设置。暂停期间不推进消化，也不会在恢复时补算暂停期间的消化伤害；挣扎等互动仍可继续。被消化者的检视描述会随消化进度变化。",
			"RPG商店" = "药水商品中的气化之躯替换为停滞药水，复活商品修正为供复活椅使用的48单位复活灵药。调整可购买特性，并将特性列表按积分价格从低到高排列。",
			"OOC检视提示" = "新增“OOC检视文本”指令，可选择预设提示或填写自定义提示，供其他玩家检视角色时查看。设置按账号保存，用于表达玩家偏好。",
			"更新日志" = "新增独立的自定义内容更新日志，每次连接游戏后自动展示一次；也可通过OOC分类中的“自定义更新日志”指令随时查看。",
		),
	)
	return entries
