// 与实体配方同步的中文食典条目，不改变其他饮食的制作方式。
/datum/z121_cookbook_catalog/proc/load_z121_cuisine()
	sections += "中式料理"
	var/common = "<p>先研读《风味美食录》获得美食知识。在桌边通过烹饪菜单制作半成品，再手持半成品点击已架锅的点燃炉灶。锅内只能装水或炼制油脂，并须烧热。烹饪过程中需要一直照看；时间受烹饪技能影响。未掌握知识的人不能接手续做，但可以食用成品。</p>"
	add_entry("东坡肉", "中式料理", "奢华", "东坡肉 腌好的东坡肉 猪五花肉 糖 米酒 蒜瓣 焖煮", "<h3>腌制与焖煮</h3><p>猪五花肉一块、糖五单位、米酒十单位、蒜瓣一份，在桌上制成腌好的东坡肉。锅内至少三十单位沸水，焖煮基础六十秒，消耗三十单位水。成品一份，营养一餐半。</p>" + common)
	add_entry("春卷", "中式料理", "精致", "春卷 生春卷 小面团 卷心菜丝 胡萝卜 擀面杖 油脂", "<h3>包卷与炸制</h3><p>小面团、卷心菜丝、胡萝卜各一份，用擀面杖在桌边备料，得到一份生春卷。锅内至少五单位热炼制油脂，炸制基础三十秒并消耗五单位油脂。成品一个，营养半餐。</p>" + common)
	add_entry("狼肉火锅", "中式料理", "精致", "狼肉火锅 狼肉火锅配料 生沃尔夫肉 狼肉 卷心菜丝 洋葱片 蒜瓣 分装", "<h3>备料与炖煮</h3><p>生狼肉两块，卷心菜丝、洋葱片、蒜瓣各一份，在桌上制成狼肉火锅配料。锅内至少一百二十单位沸水，炖煮基础六十秒并消耗一百二十单位水。</p><p>成品连同原锅一起端出，手持空碗盛取，可分四份，每份营养一餐。分完归还原锅，吃完归还原碗；分食无需美食知识。</p>" + common)
	add_entry("刀削面", "中式料理", "精致", "刀削面 生刀削面 小面团 卷心菜丝 洋葱片 菜刀 空碗", "<h3>削面与煮制</h3><p>小面团、卷心菜丝、洋葱片各一份，备好菜刀，在桌边削成生刀削面。锅内至少三十单位沸水，另一只手拿空碗；煮制基础三十秒，消耗三十单位水。成品一碗，营养一餐，吃完归还原碗。</p>" + common)
	add_entry("肉包子", "中式料理", "精致", "肉包子 生肉包 小面团 碎肉糜 洋葱片 蒸制", "<h3>包馅与蒸制</h3><p>小面团、碎肉糜、洋葱片各一份，在桌边捏成生肉包。锅内至少十单位沸水，隔水蒸制基础四十秒，消耗十单位水。成品一个，营养半餐。</p>" + common)
	add_entry("菜包子", "中式料理", "精致", "菜包子 生菜包 小面团 卷心菜丝 胡萝卜 蒸制", "<h3>包馅与蒸制</h3><p>小面团、卷心菜丝、胡萝卜各一份，在桌边捏成生菜包。锅内至少十单位沸水，隔水蒸制基础四十秒，消耗十单位水。成品一个，营养半餐。</p>" + common)
