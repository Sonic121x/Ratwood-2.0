// 来源：code/modules/spells/spell_types/wizard/buffs_debuffs/fortitude.dm
/obj/effect/proc_holder/spell/invoked/fortitude/cast(list/targets, mob/user)
	if(!z121_metamagic_cast)
		return ..()
	var/atom/A = targets[1]
	if(!isliving(A))
		revert_cast()
		return
	var/mob/living/spelltarget = A
	playsound(get_turf(spelltarget), 'sound/magic/haste.ogg', 80, TRUE, soundping = TRUE)
	if(spelltarget != user)
		if(!z121_silent(user))
			user.visible_message("[user]低声念诵咒文，[spelltarget]短暂泛起绿色光辉。")
		else
			user.visible_message(span_notice("[user]周围泛起一阵奥术微光。"))
		to_chat(user, span_notice("借由他人作为媒介，我的法术持续时间翻倍了。"))
		z121_apply_status(spelltarget, /datum/status_effect/buff/fortitude/other)
	else
		if(!z121_silent(user))
			user.visible_message("[user]低声念诵咒文，身上短暂泛起绿色光辉。")
		else
			user.visible_message(span_notice("[user]周围泛起一阵奥术微光。"))
		z121_apply_status(spelltarget, /datum/status_effect/buff/fortitude)
	return TRUE

