	)
	for(var/display in base_catalog)
		var/list/entry = base_catalog[display]
		var/list/group = item_groups[entry[2]]
		entry["group_order"] = group ? group[1] : 6
		entry["group"] = group ? group[2] : (tab == "weapon" ? "其他武器" : "其他装备")
		if(entry[2] == /obj/item/rogueweapon/shield/wood)
			entry["group_order"] = 1
			entry["group"] = "轻型装备"
			continue
		// 原有盾牌留在装备页，按对应材质归类。
		if(tab == "equipment" && group && findtext(group[2], "武器"))
			entry["group"] = replacetext(group[2], "武器", "装备")
			entry["group_order"] = group[1] == 1 ? 2 : (group[1] == 2 ? 3 : 4)
	for(var/display in additions)
		var/list/entry = additions[display]
		if(entry["tab"] != tab)
			continue
		var/key = display
		while(key in base_catalog)
			key += "·补充"
		base_catalog[key] = entry.Copy()
	return base_catalog

