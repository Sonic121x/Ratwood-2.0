// 商品介绍直接取自物品定义，不为预览创建实体或触发初始化。
/proc/z121_rpg_item_description(obj/item/item_type)
	var/list/parts = list()
	var/description = initial(item_type.desc)
	if(length(description))
		parts += description
	// 弹药袋的初始介绍可能为空，按已核对的装填类型补充实际内装物品。
	if(ispath(item_type, /obj/item/quiver))
		var/static/list/quiver_ammo = list(
			/obj/item/quiver/arrows = /obj/item/ammo_casing/caseless/rogue/arrow/iron,
			/obj/item/quiver/bodkin = /obj/item/ammo_casing/caseless/rogue/arrow/steel,
			/obj/item/quiver/pyroarrows = /obj/item/ammo_casing/caseless/rogue/arrow/pyro,
			/obj/item/quiver/poisonarrows = /obj/item/ammo_casing/caseless/rogue/arrow/poison,
			/obj/item/quiver/bolts = /obj/item/ammo_casing/caseless/rogue/bolt,
			/obj/item/quiver/heavybluntbolts = /obj/item/ammo_casing/caseless/rogue/bolt/heavyblunt,
			/obj/item/quiver/pyrobolts = /obj/item/ammo_casing/caseless/rogue/bolt/pyro,
			/obj/item/quiver/javelin/iron = /obj/item/ammo_casing/caseless/rogue/javelin,
			/obj/item/quiver/javelin/steel = /obj/item/ammo_casing/caseless/rogue/javelin/steel,
			/obj/item/quiver/sling/iron = /obj/item/ammo_casing/caseless/rogue/sling_bullet/iron,
			/obj/item/quiver/sling/steel = /obj/item/ammo_casing/caseless/rogue/sling_bullet/steel,
			/obj/item/quiver/bullet/lead = /obj/item/ammo_casing/caseless/bullet/lead,
		)
		var/obj/item/quiver/quiver_type = item_type
		var/obj/item/ammo_type = quiver_ammo[item_type]
		if(ammo_type)
			parts += "内装[initial(quiver_type.max_storage)]枚[initial(ammo_type.name)]。[initial(ammo_type.desc)]"
		else if(item_type == /obj/item/quiver)
			parts += "用于收纳箭矢或弩矢的空箭袋，最多可装[initial(quiver_type.max_storage)]支。"
	// 成品药瓶往往只有通用容器介绍，额外展示原装药剂的名称、装量和介绍。
	if(ispath(item_type, /obj/item/reagent_containers/glass/bottle))
		var/obj/item/reagent_containers/glass/bottle/bottle_type = item_type
		var/list/reagents = initial(bottle_type.list_reagents)
		for(var/reagent_path in reagents)
			if(!ispath(reagent_path, /datum/reagent))
				continue
			var/datum/reagent/reagent_type = reagent_path
			parts += "内装[reagents[reagent_path]]单位[initial(reagent_type.name)]：[initial(reagent_type.description)]"
	return html_decode(GLOB.html_tags.Replace(jointext(parts, " "), ""))

// 套装按实际交付清单展示每种物品的数量与介绍，避免只描述第一件物品。
/proc/z121_rpg_catalog_description(list/entry)
	var/list/contents = entry["contents"]
	if(!length(contents))
		return z121_rpg_item_description(entry[2])
	var/list/item_counts = list()
	for(var/item_path in contents)
		item_counts[item_path] = 1 + item_counts[item_path]
	var/list/parts = list("整套包含：")
	for(var/item_path in item_counts)
		var/obj/item/item_type = item_path
		parts += "[initial(item_type.name)] ×[item_counts[item_path]]：[z121_rpg_item_description(item_type)]"
	return html_decode(GLOB.html_tags.Replace(jointext(parts, " "), ""))

