 	wrists = /obj/item/clothing/wrists/roguetown/bracers
@@ -131,8 +131,8 @@
 
 //crossbow and axe class. Rearguard. Utility skills, no medium armor, no dodge expert. This is NOT a go-face-first-into-war class.
