+	name = "戟兵"
+	tutorial = "你是身经百战的老兵，擅使长柄武器与战斧。像你这样的人构成了佣兵行会武装的中坚。"
 	outfit = /datum/outfit/job/roguetown/mercenary/grenzelhoft_halberdier
 	traits_applied = list(TRAIT_HEAVYARMOR, TRAIT_STEELHEARTED)
 	subclass_stats = list(
@@ -97,18 +97,18 @@
 
