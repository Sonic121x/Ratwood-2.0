+	to_chat(H, span_warning("你是身经百战的老兵，擅使长柄武器与战斧。像你这样的人构成了佣兵行会武装的中坚。"))
 	backl = /obj/item/rogueweapon/scabbard/gwstrap
 	armor = /obj/item/clothing/suit/roguetown/armor/plate/blacksteel_half_plate
 	if(H.mind)
