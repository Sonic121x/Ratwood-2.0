+		var/brute_text = get_damage_descriptor_text(temp, "[m3] 有一些瘀伤。\n", "[m3] 有很多瘀伤！\n", "<B>[m1] 遍体鳞伤！！</B>\n")
 		if(brute_text)
 			msg += brute_text
 
 		temp = getFireLoss()
-		var/fire_text = get_damage_descriptor_text(temp, "[m3] some burns.\n", "[m3] many burns!\n", "<B>[m1] dragon food!!</B>\n")
+		var/fire_text = get_damage_descriptor_text(temp, "[m3] 有一些烧伤。\n", "[m3] 有多处烧伤！\n", "<B>[m1] 快被烧得不成样子了！！</B>\n")
 		if(fire_text)
 			msg += fire_text
 
 		temp = getCloneLoss()
 		if(temp)
 			if(temp < 25)
-				msg += "[t_He] [t_is] slightly deformed.\n"
+				msg += "[t_He] [t_is] 有些变形。\n"
