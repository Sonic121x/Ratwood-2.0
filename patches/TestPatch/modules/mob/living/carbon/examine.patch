diff --git a/code/modules/mob/living/carbon/examine.dm b/code/modules/mob/living/carbon/examine.dm
index 318bf1d458b1..525857ba6dec 100644
--- a/code/modules/mob/living/carbon/examine.dm
+++ b/code/modules/mob/living/carbon/examine.dm
@@ -4,7 +4,7 @@
 	var/t_has = p_have()
 	var/t_is = p_are()
 
-	. = list("<span class='info'>✠ ------------ ✠\nThis is \a <EM>[src]</EM>!")
+	. = list("<span class='info'>✠ ------------ ✠\n这是 \a <EM>[src]</EM>！")
 	var/list/obscured = check_obscured_slots()
 
 	var/m1 = "[t_He] [t_is]"
@@ -16,20 +16,20 @@
 		m3 = "I have"
 
 	if (handcuffed)
-		. += span_warning("[m1] tied up with \a [handcuffed]!")
+		. += span_warning("[m1] 被 \a [handcuffed] 捆住了！")
 	if (head)
-		. += "[m3] [head.get_examine_string(user)] on [m2] head. "
+		. += "[m3] [head.get_examine_string(user)] 戴在[m2]头上。 "
 	if(wear_mask && !(SLOT_WEAR_MASK in obscured))
-		. += "[m3] [wear_mask.get_examine_string(user)] on [m2] face."
+		. += "[m3] [wear_mask.get_examine_string(user)] 戴在[m2]脸上。"
 	if(wear_neck && !(SLOT_NECK in obscured))
-		. += "[m3] [wear_neck.get_examine_string(user)] around [m2] neck."
+		. += "[m3] [wear_neck.get_examine_string(user)] 挂在[m2]脖子上。"
 
 	for(var/obj/item/I in held_items)
 		if(!(I.item_flags & ABSTRACT))
-			. += "[m1] holding [I.get_examine_string(user)] in [m2] [get_held_index_name(get_held_index_of_item(I))]."
+			. += "[m1] 正用[m2] [get_held_index_name(get_held_index_of_item(I))]拿着 [I.get_examine_string(user)]。"
 
 	if (back)
-		. += "[m3] [back.get_examine_string(user)] on [m2] back."
+		. += "[m3] [back.get_examine_string(user)] 在[m2]背上。"
 	var/appears_dead = 0
 /*	if (stat == DEAD)
 		appears_dead = 1
@@ -41,45 +41,45 @@
 	var/list/missing = get_missing_limbs()
 	for(var/t in missing)
 		if(t==BODY_ZONE_HEAD)
