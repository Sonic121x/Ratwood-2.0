 		"headshot" = headshot,
 		"obscured" = obscured ? TRUE : FALSE,
 		// Descriptions
@@ -139,7 +139,7 @@
 
 	var/client/C
 	var/web_sound_url
-	var/artist_name = "Song Artist Hidden"
+	var/artist_name = "歌曲作者已隐藏"
 	var/song_title
 	var/list/music_extra_data = list()
 
@@ -169,7 +169,7 @@
