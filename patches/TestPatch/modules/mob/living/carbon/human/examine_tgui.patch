 		nsfw_examine_always = holder_human.client?.prefs?.nsfw_examine_always
 		ooc_notes += holder.ooc_notes
 		ooc_notes_nsfw += holder.erpprefs
@@ -107,7 +107,7 @@
 
 	var/list/data = list(
 		// Identity
-		"character_name" = obscured ? "Unknown" : char_name,
