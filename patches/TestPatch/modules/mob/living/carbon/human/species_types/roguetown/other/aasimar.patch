 code/modules/mob/living/carbon/human/species_types/roguetown/other/aasimar.dm | 23 +++++++++++------------
 1 file changed, 11 insertions(+), 12 deletions(-)

diff --git a/code/modules/mob/living/carbon/human/species_types/roguetown/other/aasimar.dm b/code/modules/mob/living/carbon/human/species_types/roguetown/other/aasimar.dm
index e915b8656575..2e5212ba7990 100644
--- a/code/modules/mob/living/carbon/human/species_types/roguetown/other/aasimar.dm
+++ b/code/modules/mob/living/carbon/human/species_types/roguetown/other/aasimar.dm
@@ -4,17 +4,16 @@
 /datum/species/aasimar
 	name = "Aasimar"
 	id = "aasimar"
-	desc = "<b>Aasimar</b><br>\
-	Aasimar are born of a rare union between Humens and Angels. \
-	They bear the mark of their celestial touch through their many varying physical features. \
-	Their looks resemble the traditional characteristics of whichever of the Gods their Angel parent was associated with. \
-	Most commonly, Aasimar are similar to Humens, albeit taller, and commonly possess an uncanny beauty. \
-	When compared to the average Humen, they have strangely colored skin and are more physically frail. \
-	Because of their upbringing, they make for natural conduits for godly powers. \
-	The vale's populace holds them with a mixture of uneasy mixture of fear and respect. \
-	Due to their celestial nature, it is widely believed that an Aasimar's death is a bad omen...<br>\
-	(+1 Stat of their choice, Lack of Hunger & Thirst)"
-
+	desc = "<b>神裔</b><br>\
+	神裔诞生于人类与天使之间极其罕见的结合。\
+	他们多样的外貌特征都带着天界触摸留下的印记。\
+	其容貌往往会显现出其天使父母所侍奉诸神的传统特征。\
+	最常见的神裔与人类相似，只是更高挑，也往往带有一种非凡的美感。\
+	与普通人类相比，他们的肤色常显得异于常人，而肉体也更为脆弱。\
+	由于这样的出身，他们往往天然适合作为神力的媒介。\
+	山谷中的民众对他们既敬且惧，怀着不安的敬畏之心看待他们。\
+	也正因其天界本质，人们普遍相信神裔之死会带来不祥之兆……<br>\
+	(+1 自选属性, 无饥无渴)"
 	skin_tone_wording = "Craft"
 
 	species_traits = list(EYECOLOR,HAIR,FACEHAIR,LIPS,STUBBLE,OLDGREY)
@@ -101,7 +100,7 @@
 
 /datum/species/aasimar/after_creation(mob/living/carbon/C)
 	..()
-	to_chat(C, "<span class='info'>I can speak Celestial with ,c before my speech.</span>")
+	to_chat(C, "<span class='info'>我可以在发言前输入 ,c 来说天界语。</span>")
 
 /datum/species/aasimar/on_species_loss(mob/living/carbon/C)
 	. = ..()
