diff --git a/code/modules/mob/living/carbon/human/species_types/roguetown/other/orc.dm b/code/modules/mob/living/carbon/human/species_types/roguetown/other/orc.dm
index fc0627d4936c..3c835fb5a044 100644
--- a/code/modules/mob/living/carbon/human/species_types/roguetown/other/orc.dm
+++ b/code/modules/mob/living/carbon/human/species_types/roguetown/other/orc.dm
@@ -1,11 +1,10 @@
 /datum/species/orc
 	name = "Orc"
 	id = "orc"
-	desc = "<b>Orcs</b><br>\
-	This is made for events. You shouldn't be able to use this as a normal person, \
-	For courtesies sake however, I've tried to half-assedly balance it for use by players\
-	(+1 Strength, +1 Constitution, -1 Intelligence, -1 Speed)"
-
+	desc = "<b>兽人</b><br>\
+	这个种族原本是为事件内容准备的。正常情况下，你不该把它当作普通角色使用。\
+	不过出于礼貌，我还是半认真地把它调整到了玩家勉强可用的程度\
+	(+1 力量, +1 体质, -1 智力, -1 速度)"
 	skin_tone_wording = "Clan"
 
 	species_traits = list(EYECOLOR,HAIR,FACEHAIR,LIPS,STUBBLE,OLDGREY)
@@ -95,7 +94,7 @@
 
 /datum/species/orc/after_creation(mob/living/carbon/C)
 	..()
-	to_chat(C, "<span class='info'>I can speak Orcish with ,o before my speech.</span>")
+	to_chat(C, "<span class='info'>我可以在发言前输入 ,o 来说兽人语。</span>")
 
 /datum/species/orc/on_species_loss(mob/living/carbon/C)
 	. = ..()
