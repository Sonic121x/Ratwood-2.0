 	id = "shapebear"
 	species_traits = list(NO_UNDERWEAR, NO_ORGAN_FEATURES, NO_BODYPART_FEATURES)
 	inherent_traits = list(
@@ -98,7 +98,7 @@
 // BEAR SPECIFIC ITEMS //
