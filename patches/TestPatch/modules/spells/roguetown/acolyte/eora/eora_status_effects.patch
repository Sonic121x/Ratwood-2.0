+	name = "阿瑞里安神化"
+	desc = "神圣之力在你体内奔涌，强化着你的一切能力。"
 	icon_state = "buff"
 
 /datum/status_effect/buff/ashen_aril
@@ -27,24 +27,24 @@
 
 	switch(current_boost)
