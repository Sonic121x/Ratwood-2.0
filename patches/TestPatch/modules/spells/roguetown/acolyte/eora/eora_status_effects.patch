 					new /obj/item/ash(owner.loc)
-					to_chat(owner, span_warning("Your body cracks as a new wound opens, ash spilling forth."))
+					to_chat(owner, span_warning("你的身体皲裂开来，一道新的伤口张开，灰烬从中簌簌落下。"))
 
