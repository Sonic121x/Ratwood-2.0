+		living_target.visible_message(span_warning("[living_target] 体内的虫灾骤然爆发，化作凶恶瘟疫！"),span_userdanger("我体内的虫灾猛然爆发，带来难以承受的剧痛！"))
 		remove_enchantment()
 
