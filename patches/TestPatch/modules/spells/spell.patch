-		return FALSE
-
-	if(!can_admin_use(user))
+		to_chat(user, span_warning("我不能在这里施放这个法术！"))
 		return FALSE
 
 	if(!skipcharge)
@@ -280,63 +270,63 @@
 			return FALSE
 
 	if(user.stat && !stat_allowed)
