 code/modules/spells/spell_types/bardic/dirge_misfortune.dm | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/code/modules/spells/spell_types/bardic/dirge_misfortune.dm b/code/modules/spells/spell_types/bardic/dirge_misfortune.dm
index 3534ca0a2c72..52e2a041c869 100644
