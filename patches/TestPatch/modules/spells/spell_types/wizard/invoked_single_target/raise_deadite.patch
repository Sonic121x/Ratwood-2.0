---
 code/modules/spells/spell_types/wizard/invoked_single_target/raise_deadite.dm | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/code/modules/spells/spell_types/wizard/invoked_single_target/raise_deadite.dm b/code/modules/spells/spell_types/wizard/invoked_single_target/raise_deadite.dm
index 159331756e79..782c063e393e 100644
--- a/code/modules/spells/spell_types/wizard/invoked_single_target/raise_deadite.dm
+++ b/code/modules/spells/spell_types/wizard/invoked_single_target/raise_deadite.dm
@@ -1,6 +1,6 @@
 /obj/effect/proc_holder/spell/invoked/raise_deadite
-	name = "Raise Deadite"
-	desc = "Infuse the target with quick acting Rot, raising them as a deadite. They will not be friendly to you."
+	name = "唤起尸鬼"
+	desc = "将迅速发作的腐坏灌入目标体内，使其化作尸鬼复起。它不会对你友善。"
 	cost = 3
 	xp_gain = TRUE
 	releasedrain = 60
@@ -13,7 +13,7 @@
 	no_early_release = TRUE
 	movement_interrupt = FALSE
 	spell_tier = 2
-	invocations = list("Vivere Putrescere!")
+	invocations = list("腐生，再起！")
 	invocation_type = "shout"
 	charging_slowdown = 2
 	chargedloop = /datum/looping_sound/invokegen
@@ -25,11 +25,11 @@
 	for(var/mob/living/carbon/human/M in targets)
 		if(!HAS_TRAIT(M, TRAIT_ZOMBIE_IMMUNE) && ishuman(M) && M.mind)
 			if (M.stat < DEAD && !M.InCritical())
-				to_chat(user, span_notice("They aren't dead enough yet!"))
+				to_chat(user, span_notice("这具尸体还不够彻底地死去！"))
 				revert_cast()
 			else
 				playsound(get_turf(M), 'sound/magic/magnet.ogg', 80, TRUE, soundping = TRUE)
-				user.visible_message("[user] mutters an incantation and [M] twitches with unnatural life!")
+				user.visible_message("[user] 低声念诵咒文，[M] 以违逆天理的生命抽搐了起来！")
 				M.blood_volume = BLOOD_VOLUME_NORMAL
 				M.setOxyLoss(0, updating_health = FALSE, forced = TRUE)
 				M.setToxLoss(0, updating_health = FALSE, forced = TRUE)
@@ -42,7 +42,7 @@
 					Z.wake_zombie(TRUE)
 				M.emote("scream")
 		else
-			to_chat(user, span_notice("They can not be risen!"))
+			to_chat(user, span_notice("它无法被这样唤起！"))
 			revert_cast()
 
 	return
