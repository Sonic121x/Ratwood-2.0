From 98690fd563efae2a44b29a78bfca11b3dc96abee Mon Sep 17 00:00:00 2001
From: Translation Patch Toolkit <translation@local>
Date: Mon, 25 May 2026 12:43:47 +0800
Subject: [PATCH] 翻译 code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm b/code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm
index 029802ee33f3..ac901ae4f956 100644
--- a/code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm
+++ b/code/modules/spells/spell_types/wizard/invoked_single_target/silence.dm
@@ -1,6 +1,6 @@
 /obj/effect/proc_holder/spell/invoked/silence
-	name = "Silence"
-	desc = "Quiet the target's tongue. Does not work against full-fledged mages."
+	name = "缄默术"
+	desc = "封住目标之舌。对真正的大法师不起作用。"
 	cost = 3
 	xp_gain = TRUE
 	releasedrain = 60
@@ -14,7 +14,7 @@
 	no_early_release = TRUE
 	movement_interrupt = FALSE
 	spell_tier = 1
-	invocations = list("Silentium!")
+	invocations = list("归于缄默。")
 	invocation_type = "whisper"
 	glow_color = GLOW_COLOR_BUFF
 	glow_intensity = GLOW_INTENSITY_LOW
@@ -29,22 +29,22 @@
 	associated_skill = /datum/skill/magic/holy
 	chargetime = 9
 	recharge_time = 120 SECONDS
-	invocations = list("Lunaria Silentium!")
+	invocations = list("月辉，赐其缄默。")
 
 /obj/effect/proc_holder/spell/invoked/silence/cast(list/targets, mob/user = usr)
 	if(isliving(targets[1]))
 		var/mob/living/carbon/target = targets[1]
 		if(HAS_TRAIT(target, TRAIT_COUNTERCOUNTERSPELL) || HAS_TRAIT(target, TRAIT_ANTIMAGIC) || HAS_TRAIT(target, TRAIT_MUTE))
-			to_chat(user, "<span class='warning'>The spell fizzles, it won't work on them!</span>")
+			to_chat(user, "<span class='warning'>法术噗地散掉了，对方不会受影响！</span>")
 			revert_cast()
 			return
 		if(target.get_skill_level(/datum/skill/magic/arcane) > 2 || target.get_skill_level(/datum/skill/magic/holy) > 2)
-			to_chat(user, "<span class='warning'>Their magic is too strong, it won't work on them!</span>")
+			to_chat(user, "<span class='warning'>对方的魔力过于强盛，这招对他无效！</span>")
 			revert_cast()
 			return
 		ADD_TRAIT(target, TRAIT_MUTE, MAGIC_TRAIT)
 		playsound(get_turf(target), 'sound/magic/zizo_snuff.ogg', 80, TRUE, soundping = TRUE)
-		to_chat(target, span_warning("The wind in my voice goes still. I can't speak!"))
+		to_chat(target, span_warning("我喉中的风声忽然止息了。我说不出话了！"))
 		var/dur = max((9 * (user.get_skill_level(associated_skill, 5))))
 		addtimer(CALLBACK(src, PROC_REF(remove_buff), target), wait = dur SECONDS)
 		return TRUE
@@ -52,4 +52,4 @@
 
 /obj/effect/proc_holder/spell/invoked/silence/proc/remove_buff(mob/living/carbon/target)
 	REMOVE_TRAIT(target, TRAIT_MUTE, MAGIC_TRAIT)
-	to_chat(target, span_warning("My voice returns to me!"))
+	to_chat(target, span_warning("我的声音回来了！"))
