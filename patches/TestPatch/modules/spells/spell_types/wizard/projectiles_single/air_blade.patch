@@ -6,10 +6,10 @@
 */
 
 /obj/effect/proc_holder/spell/invoked/projectile/airblade
-	name = "Air Blade"
-	desc = "Slash the air with your weapon, forming an arcyne blade in the air that can strike enemies at range. \n\
