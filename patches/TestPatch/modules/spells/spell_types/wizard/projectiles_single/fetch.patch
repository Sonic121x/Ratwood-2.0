 code/modules/spells/spell_types/wizard/projectiles_single/fetch.dm | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/code/modules/spells/spell_types/wizard/projectiles_single/fetch.dm b/code/modules/spells/spell_types/wizard/projectiles_single/fetch.dm
index 7e476c6d827a..e45c81628ef5 100644
