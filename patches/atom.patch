 code/game/atoms.dm | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/code/game/atoms.dm b/code/game/atoms.dm
index cb0eda2a78..ed6795c261 100644
--- a/code/game/atoms.dm
+++ b/code/game/atoms.dm
@@ -375,16 +375,16 @@
  */
 /atom/proc/get_examine_name(mob/user)
 	. = "\a [src]"
-	var/list/override = list(gender == PLURAL ? "some" : "a", " ", "[name]")
+	var/list/override = list(gender == PLURAL ? "一些" : "个", "", "[name]")
 	if(article)
-		. = "[article] [src]"
+		. = "[article][src]"
 		override[EXAMINE_POSITION_ARTICLE] = article
 	if(SEND_SIGNAL(src, COMSIG_ATOM_GET_EXAMINE_NAME, user, override) & COMPONENT_EXNAME_CHANGED)
 		. = override.Join("")
 
 ///Generate the full examine string of this atom (including icon for goonchat)
 /atom/proc/get_examine_string(mob/user, thats = FALSE)
-	return "[thats? "That's ":""][get_examine_name(user)]"
+	return "[thats? "那是":""][get_examine_name(user)]"
 
 /atom/proc/get_inspect_button()
 	return ""
