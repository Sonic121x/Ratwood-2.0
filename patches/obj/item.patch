 code/game/objects/examine.dm | 28 ++++++++++++++--------------
 code/game/objects/items.dm   |  2 +-
 2 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/code/game/objects/examine.dm b/code/game/objects/examine.dm
index 8dce678bf3..1e4f32d215 100644
--- a/code/game/objects/examine.dm
+++ b/code/game/objects/examine.dm
@@ -12,23 +12,23 @@
 	var/real_value = get_real_price()
 	if(real_value > 0)
 		if(HAS_TRAIT(user, TRAIT_SEEPRICES) || simpleton_price)
-			. += span_info("Value: [real_value] mammon")
+			. += span_info("价值：[real_value] 玛门")
 
 		else if(HAS_TRAIT(user, TRAIT_SEEPRICES_SHITTY))
 			//you can get up to 50% of the value if you have shitty see prices
 			var/static/fumbling_seed = text2num(GLOB.rogue_round_id)
 			var/fumbled_value = max(1, round(real_value + (real_value * clamp(noise_hash(real_value, fumbling_seed) - 0.25, -0.25, 0.25)), 1))
-			. += span_info("Value: [fumbled_value] mammon... <i>I think</i>")
+			. += span_info("价值：[fumbled_value] 玛门...<i>大概</i>")
 
 	if(smeltresult)
 		var/obj/item/smelted = smeltresult
-		. += span_info("Smelts into [smelted.name].")
+		. += span_info("可被冶炼成[smelted.name]。")
 	
 	if(nudist_approved)
 		if(HAS_TRAIT(user, TRAIT_NUDE_SLEEPER))
-			. += span_smallnotice("I can tolerate having this on when I sleep.")
+			. += span_smallnotice("穿着这个睡觉我也能接受。")
 		else if(HAS_TRAIT(user, TRAIT_NUDIST))
-			. += span_smallnotice("I can tolerate wearing this.")
+			. += span_smallnotice("穿这个我倒是不介意。")
 
 	for(var/datum/examine_effect/E in examine_effects)
 		E.trigger(user)
@@ -43,16 +43,16 @@
 	var/result
 
 	if(obj_broken)
-		return span_warning("It's broken.")
+		return span_warning("它坏了。")
 	switch(int_percent)
 		if(1 to 15)
-			result = span_warning("It's nearly broken.")
+			result = span_warning("它快要散架了。")
 		if(16 to 30)
-			result = span_warning("It's severely damaged.")
+			result = span_warning("它严重损坏了。")
 		if(31 to 80)
-			result = span_warning("It's damaged.")
+			result = span_warning("它受损了。")
 		if(80 to 99)
-			result = span_warning("It's a little damaged.")
+			result = span_warning("它有一点损坏。")
 	return result
 
 /obj/item/clothing/integrity_check(elaborate = FALSE)
@@ -67,12 +67,12 @@
 	if(percent < 100)
 		switch(percent)
 			if(1 to 15)
-				result = span_warning("It's nearly broken.")
+				result = span_warning("它快要散架了。")
 			if(16 to 30)
-				result = span_warning("It's severely damaged.")
+				result = span_warning("它严重损坏了。")
 			if(31 to 80)
-				result = span_warning("It's damaged.")
+				result = span_warning("它受损了。")
 			if(80 to 99)
-				result = span_warning("It's a little damaged.")
+				result = span_warning("它有一点损坏。")
 	return result
 	
diff --git a/code/game/objects/items.dm b/code/game/objects/items.dm
index c0b326b89a..b79cbb7e20 100644
--- a/code/game/objects/items.dm
+++ b/code/game/objects/items.dm
@@ -1382,7 +1382,7 @@ GLOBAL_VAR_INIT(rpg_loot_items, FALSE)
 		// Override for children that want more than 1 ash per item (Bundle as pseudo-stack)
 		for(var/i in 1 to amount)
 			var/obj/item/ash/A = new ash_type(T)
-			A.desc += "\nLooks like this used to be \an [name] some time ago."
+			A.desc += "\n这看起来曾经是[name]。"
 		..()
 
 /obj/item/acid_melt()
