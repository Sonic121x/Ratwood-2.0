---
 code/modules/reagents/reagent_containers/glass.dm |  4 ++--
 modular/Neu_Food/code/others/dairy.dm             | 10 +++++-----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/code/modules/reagents/reagent_containers/glass.dm b/code/modules/reagents/reagent_containers/glass.dm
index 1d12b77f81..159957a023 100644
--- a/code/modules/reagents/reagent_containers/glass.dm
+++ b/code/modules/reagents/reagent_containers/glass.dm
@@ -308,7 +308,7 @@
 /obj/item/reagent_containers/glass/proc/onfill(obj/target, mob/user, silent = FALSE)
 
 /obj/item/reagent_containers/glass/bucket
-	name = "bucket"
+	name = "木桶"
 	desc = ""
 	icon = 'icons/roguetown/items/misc.dmi'
 	lefthand_file = 'modular/Neu_Food/icons/food_lefthand.dmi'
@@ -375,7 +375,7 @@
 	..()
 	if (slot == SLOT_HEAD)
 		if(reagents.total_volume)
-			to_chat(user, span_danger("[src]'s contents spill all over you!"))
+			to_chat(user, span_danger("[src]里的东西全洒在你身上了！"))
 			reagents.reaction(user, TOUCH)
 			reagents.clear_reagents()
 		reagents.flags = NONE
diff --git a/modular/Neu_Food/code/others/dairy.dm b/modular/Neu_Food/code/others/dairy.dm
index 79ee258f23..2fc0098f94 100644
--- a/modular/Neu_Food/code/others/dairy.dm
+++ b/modular/Neu_Food/code/others/dairy.dm
@@ -14,9 +14,9 @@
 	update_cooktime(user)
 	if(istype(I, /obj/item/reagent_containers/powder/salt))
 		if(!reagents.has_reagent(/datum/reagent/consumable/milk, 15))
-			to_chat(user, span_warning("Not enough milk."))
+			to_chat(user, span_warning("牛奶不足。"))
 			return
-		to_chat(user, span_warning("Adding salt to the milk."))
+		to_chat(user, span_warning("往牛奶里加盐。"))
 		playsound(src, pick('sound/foley/waterwash (1).ogg','sound/foley/waterwash (2).ogg'), 100, FALSE)
 		if(do_after(user,short_cooktime, target = src))
 			add_sleep_experience(user, /datum/skill/craft/cooking, user.STAINT)
@@ -29,9 +29,9 @@
 	update_cooktime(user)
 	if(istype(I, /obj/item/kitchen/spoon))
 		if(!reagents.has_reagent(/datum/reagent/consumable/milk/salted, 15))
-			to_chat(user, span_warning("Not enough salted milk."))
+			to_chat(user, span_warning("咸牛奶不足。"))
 			return
-		user.visible_message(span_info("[user] churns butter..."))
+		user.visible_message(span_info("[user]搅拌起黄油..."))
 		playsound(get_turf(user), 'modular/Neu_Food/sound/churn.ogg', 100, TRUE, -1)
 		if(do_after(user,long_cooktime, target = src))
 			add_sleep_experience(user, /datum/skill/craft/cooking, user.STAINT)
@@ -106,7 +106,7 @@
 	update_cooktime(user)
 	if(istype(I, /obj/item/natural/cloth))
 		if(reagents.has_reagent(/datum/reagent/consumable/milk/salted, 5))
-			user.visible_message(span_info("[user] strains fresh cheese..."))
+			user.visible_message(span_info("[user]滤出新鲜的奶酪..."))
 			playsound(src, pick('sound/foley/waterwash (1).ogg','sound/foley/waterwash (2).ogg'), 100, FALSE)
 			if(do_after(user,long_cooktime, target = src))
 				add_sleep_experience(user, /datum/skill/craft/cooking, user.STAINT)
