---
 code/modules/roguetown/roguejobs/blacksmith/forge.dm | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/code/modules/roguetown/roguejobs/blacksmith/forge.dm b/code/modules/roguetown/roguejobs/blacksmith/forge.dm
index 9f15da9ba4..b7a0a3cc61 100644
--- a/code/modules/roguetown/roguejobs/blacksmith/forge.dm
+++ b/code/modules/roguetown/roguejobs/blacksmith/forge.dm
@@ -1,8 +1,8 @@
 
 /obj/machinery/light/rogue/forge
 	icon = 'icons/roguetown/misc/forge.dmi'
-	name = "stone forge"
-	desc = "This forge sings of war and creation."
+	name = "石制锻炉"
+	desc = "这座锻炉吟唱着战争与创造的诗篇。"
 	icon_state = "forge0"
 	base_state = "forge"
 	density = TRUE
@@ -20,7 +20,7 @@
 			T.hott = tyme
 			addtimer(CALLBACK(T, TYPE_PROC_REF(/obj/item/rogueweapon/tongs, make_unhot), tyme), heat_time)
 			T.update_icon()
-			user.visible_message(span_info("[user] heats the bar."))
+			user.visible_message(span_info("[user]加热了锭。"))
 			var/obj/item/rogueweapon/tongs/heldstuff = user.get_active_held_item()
 			if(istype(heldstuff, /obj/item/rogueweapon/tongs/stone))
 				heldstuff.obj_integrity -= 1
