+
+export const DmModsIncludeTarget = new Juke.Target({
+  executes: async () => {
+    const modFiles = Juke.glob("mods/**/*.dm")
+      .filter((file) => file !== MODS_INCLUDE_FILE)
+      .sort((a, b) => a.localeCompare(b));
+
+    const content = [
+      "// This file is auto-generated by tools/build/build.ts.",
+      "// Run build.cmd after adding or removing files under mods/.",
+      ...modFiles.map((file) =>
+        `#include "${file.replace(/^mods\//, "").replace(/\//g, "\\")}"`,
+      ),
+      "",
+    ].join("\n");
+
+    fs.mkdirSync("mods", { recursive: true });
+    fs.writeFileSync(MODS_INCLUDE_FILE, content);
+  },
+});
 
