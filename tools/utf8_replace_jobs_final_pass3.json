        {
          "old": "name = \"Naledi Refugee\"",
          "new": "name = \"Naledi 难民\"",
          "count": 1
        },
        {
          "old": "to_chat(H, span_warning(\"An asylum-seeker from the war-torn deserts of Naledi, \\\n\tdriven north as your homeland continues to be ravaged by an endless conflict against the Djinn.\"))",
          "new": "to_chat(H, span_warning(\"你是来自战火摧残之地 Naledi 荒漠的避难者，\\\n\t故土仍在与 Djinn 的无尽战火中被反复蹂躏，于是你一路被逼向北方。\"))",
          "count": 1
        }
      ]
    },
    {
      "path": "code/modules/jobs/job_types/roguetown/adventurer/types/combat/foreigner/grenzelhoft.dm",
      "replacements": [
        {
          "old": "name = \"Grenzelhoft Bluthund\"",
          "new": "name = \"Grenzelhoft 血犬\"",
          "count": 1
        },
        {
          "old": "tutorial = \"Grenzelhoftian mercenaries are one of a kind. \\\n\tIn a world of cheats, blaggards and broken oaths? They stand firm. \\\n\tA guild of individuals who, once under contract, will follow it to the letter. \\\n\tFor some reason, whether glory or madness, you'd gone against that. Branded an outcast - a 'bluthund'. \\\n\tYou yet retain your equipment, for they could not strip that of you. Unlike your titles.\"",
          "new": "tutorial = \"Grenzelhoft 的佣兵自成一格。 \\\n\t在这充满欺诈、无赖与背誓者的世道里，他们仍会站稳脚跟。 \\\n\t那是一个由个体组成的行会，一旦签下契约，便会逐字逐句履行到底。 \\\n\t可不知是出于荣耀还是疯狂，你偏偏违逆了这一切，于是被烙成弃徒, 一条“血犬”。 \\\n\t不过他们终究没能夺走你的装备，只夺走了你的头衔。\"",
          "count": 1
        }
      ]
    },
